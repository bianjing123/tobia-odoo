<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_tb_approval" model="res.groups.privilege">
        <field name="name">审批中心</field>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">审批中心菜单</field>
        <field name="privilege_id" ref="privilege_tb_approval"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
    </record>
</odoo>
