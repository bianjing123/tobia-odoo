<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tb_web_theme.ColorSchemeToggle">
        <button class="tb_theme_scheme_toggle" t-on-click="() => this.toggle()"
                t-att-title="this.isDark ? '切换到亮色主题' : '切换到暗色主题'"
                t-att-aria-label="this.isDark ? '切换到亮色主题' : '切换到暗色主题'">
            <svg t-if="!this.isDark" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M13.5 9.8A6 6 0 0 1 6.2 2.5a6 6 0 1 0 7.3 7.3z" fill="currentColor"/>
            </svg>
            <svg t-else="" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="3.2" fill="currentColor"/>
                <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                    <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.42 1.42M11.53 11.53l1.42 1.42M12.95 3.05l-1.42 1.42M4.47 11.53l-1.42 1.42"/>
                </g>
            </svg>
        </button>
    </t>

</templates>
