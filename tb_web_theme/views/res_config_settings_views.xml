<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tb.web.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']/widget[@name='res_config_dev_tool']" position="before">
                <block title="Tobia Theme" name="tb_theme_setting_container">
                    <setting id="tb_theme_icon_setting" string="Small Icon"
                             help="Brand mark shown in the browser tab, the top bar and the login page. A square PNG works best.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label class="col-lg-3" for="tb_theme_icon" string="Small Icon"/>
                                <field name="tb_theme_icon" widget="image" class="float-start o_avatar bg-view"
                                       options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.webp,.ico,.svg'}"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="tb_theme_login_bg_setting" string="Login Page Background"
                             help="Picture displayed behind the login card. A wide landscape image works best.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label class="col-lg-3" for="tb_theme_login_bg" string="Login Page Background"/>
                                <field name="tb_theme_login_bg" widget="image" class="float-start w-50 bg-view"
                                       options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.webp'}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
